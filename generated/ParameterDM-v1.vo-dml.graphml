<?xml version="1.0" encoding="UTF-8"?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns/graphml"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://www.yworks.com/xml/schema/graphml/1.0/ygraphml.xsd">
   <key xmlns:y="http://www.yworks.com/xml/graphml"
        attr.name="Title"
        attr.type="string"
        for="graph"
        id="t0">
      <default xml:space="preserve">pdl</default>
   </key>
   <key xmlns:y="http://www.yworks.com/xml/graphml"
        attr.name="description"
        attr.type="string"
        for="node"
        id="k1"/>
   <key xmlns:y="http://www.yworks.com/xml/graphml"
        id="k2"
        for="node"
        yfiles.type="nodegraphics"/>
   <key xmlns:y="http://www.yworks.com/xml/graphml"
        id="k3"
        for="edge"
        yfiles.type="edgegraphics"/>
   <key xmlns:y="http://www.yworks.com/xml/graphml"
        id="k4"
        for="graph"
        yfiles.type="postprocessors"/>
   <graph edgedefault="directed"><!--nodes-->
      <node id="pdl:BaseParameterType">
         <data key="k1">BaseParameterType</data>
         <data xmlns:y="http://www.yworks.com/xml/graphml" key="k2">
            <y:UMLClassNode>
               <y:Fill color="#BDB992" transparent="false"/>
               <y:BorderStyle color="#000000" type="line" width="1.0"/>
               <y:NodeLabel alignment="center" autoSizePolicy="content" fontFamily="Dialog" fontSize="12" fontStyle="bolditalic" hasBackgroundColor="false" hasLineColor="false" horizontalTextPosition="center" iconTextGap="4" modelName="internal" modelPosition="c" textColor="#000000" verticalTextPosition="bottom" visible="true" xml:space="preserve" y="3.0">BaseParameterType</y:NodeLabel>
               <y:UML clipContent="true"
                      constraint=""
                      hasDetailsColor="false"
                      omitDetails="false"
                      stereotype="dataType"
                      use3DEffect="true">
                  <y:AttributeLabel xml:space="preserve"/>
                  <y:MethodLabel xml:space="preserve"/>
               </y:UML>
            </y:UMLClassNode>
         </data>
      </node>
      <node id="pdl:ParameterSemantics">
         <data key="k1">ParameterSemantics</data>
         <data xmlns:y="http://www.yworks.com/xml/graphml" key="k2">
            <y:UMLClassNode>
               <y:Fill color="#BDB992" transparent="false"/>
               <y:BorderStyle color="#000000" type="line" width="1.0"/>
               <y:NodeLabel alignment="center" autoSizePolicy="content" fontFamily="Dialog" fontSize="12" fontStyle="bolditalic" hasBackgroundColor="false" hasLineColor="false" horizontalTextPosition="center" iconTextGap="4" modelName="internal" modelPosition="c" textColor="#000000" verticalTextPosition="bottom" visible="true" xml:space="preserve" y="3.0">ParameterSemantics</y:NodeLabel>
               <y:UML clipContent="true"
                      constraint=""
                      hasDetailsColor="false"
                      omitDetails="false"
                      stereotype="dataType"
                      use3DEffect="true">
                  <y:AttributeLabel xml:space="preserve"/>
                  <y:MethodLabel xml:space="preserve"/>
               </y:UML>
            </y:UMLClassNode>
         </data>
      </node>
      <node id="pdl:ParameterOrGroup">
         <data key="k1">ParameterOrGroup</data>
         <data xmlns:y="http://www.yworks.com/xml/graphml" key="k2">
            <y:UMLClassNode>
               <y:Fill color="#BDB992" transparent="false"/>
               <y:BorderStyle color="#000000" type="line" width="1.0"/>
               <y:NodeLabel alignment="center" autoSizePolicy="content" fontFamily="Dialog" fontSize="12" fontStyle="bolditalic" hasBackgroundColor="false" hasLineColor="false" horizontalTextPosition="center" iconTextGap="4" modelName="internal" modelPosition="c" textColor="#000000" verticalTextPosition="bottom" visible="true" xml:space="preserve" y="3.0">ParameterOrGroup</y:NodeLabel>
               <y:UML clipContent="true"
                      constraint=""
                      hasDetailsColor="false"
                      omitDetails="false"
                      stereotype=""
                      use3DEffect="true">
                  <y:AttributeLabel xml:space="preserve">+name : ivoa:string
</y:AttributeLabel>
                  <y:MethodLabel xml:space="preserve"/>
               </y:UML>
            </y:UMLClassNode>
         </data>
      </node>
      <node id="pdl:ParameterDefinition">
         <data key="k1">ParameterDefinition</data>
         <data xmlns:y="http://www.yworks.com/xml/graphml" key="k2">
            <y:UMLClassNode>
               <y:Fill color="#BDB992" transparent="false"/>
               <y:BorderStyle color="#000000" type="line" width="1.0"/>
               <y:NodeLabel alignment="center" autoSizePolicy="content" fontFamily="Dialog" fontSize="12" fontStyle="bold" hasBackgroundColor="false" hasLineColor="false" horizontalTextPosition="center" iconTextGap="4" modelName="internal" modelPosition="c" textColor="#000000" verticalTextPosition="bottom" visible="true" xml:space="preserve" y="3.0">ParameterDefinition</y:NodeLabel>
               <y:UML clipContent="true"
                      constraint=""
                      hasDetailsColor="false"
                      omitDetails="false"
                      stereotype=""
                      use3DEffect="true">
                  <y:AttributeLabel xml:space="preserve">+description : ivoa:string
+kind : pdl:BaseParameterType
+semantics : pdl:ParameterSemantics
</y:AttributeLabel>
                  <y:MethodLabel xml:space="preserve"/>
               </y:UML>
            </y:UMLClassNode>
         </data>
      </node>
      <node id="pdl:ParameterGroup">
         <data key="k1">ParameterGroup</data>
         <data xmlns:y="http://www.yworks.com/xml/graphml" key="k2">
            <y:UMLClassNode>
               <y:Fill color="#BDB992" transparent="false"/>
               <y:BorderStyle color="#000000" type="line" width="1.0"/>
               <y:NodeLabel alignment="center" autoSizePolicy="content" fontFamily="Dialog" fontSize="12" fontStyle="bold" hasBackgroundColor="false" hasLineColor="false" horizontalTextPosition="center" iconTextGap="4" modelName="internal" modelPosition="c" textColor="#000000" verticalTextPosition="bottom" visible="true" xml:space="preserve" y="3.0">ParameterGroup</y:NodeLabel>
               <y:UML clipContent="true"
                      constraint=""
                      hasDetailsColor="false"
                      omitDetails="false"
                      stereotype=""
                      use3DEffect="true">
                  <y:AttributeLabel xml:space="preserve"/>
                  <y:MethodLabel xml:space="preserve"/>
               </y:UML>
            </y:UMLClassNode>
         </data>
      </node>
      <!--imported nodes-->
      <!--edges-->
      <edge xmlns:y="http://www.yworks.com/xml/graphml"
            id="d69e41"
            source="pdl:ParameterDefinition"
            target="pdl:ParameterOrGroup">
         <data key="k3">
            <y:PolyLineEdge>
               <y:LineStyle color="#FF0000" type="line" width="2.0"/>
               <y:Arrows source="none" target="white_delta"/>
               <y:BendStyle smoothed="false"/>
            </y:PolyLineEdge>
         </data>
      </edge>
      <edge xmlns:y="http://www.yworks.com/xml/graphml"
            id="d69e74"
            source="pdl:ParameterGroup"
            target="pdl:ParameterOrGroup">
         <data key="k3">
            <y:PolyLineEdge>
               <y:LineStyle color="#FF0000" type="line" width="2.0"/>
               <y:Arrows source="none" target="white_delta"/>
               <y:BendStyle smoothed="false"/>
            </y:PolyLineEdge>
         </data>
      </edge>
      <edge xmlns:y="http://www.yworks.com/xml/graphml"
            id="d69e76"
            source="pdl:ParameterGroup"
            target="pdl:ParameterDefinition">
         <data key="k3">
            <y:PolyLineEdge>
               <y:LineStyle color="#9393FF" type="line" width="2.0"/>
               <y:Arrows source="diamond" target="standard"/>
               <y:BendStyle smoothed="false"/>
               <y:EdgeLabel alignment="center" configuration="AutoFlippingLabel" distance="2.0" fontFamily="Dialog" fontSize="12" fontStyle="plain" hasBackgroundColor="false" hasLineColor="false" horizontalTextPosition="center" iconTextGap="4" modelName="six_pos" modelPosition="head" preferredPlacement="centered" ratio="0.5" textColor="#000000" verticalTextPosition="bottom" visible="true" xml:space="preserve">params<y:PreferredPlacementDescriptor angle="0.0" angleOffsetOnRightSide="0" angleReference="absolute" angleRotationOnRightSide="co" distance="-1.0" placement="center" side="on_edge" sideReference="relative_to_edge_flow"/>
   </y:EdgeLabel>
               <y:EdgeLabel alignment="center" configuration="AutoFlippingLabel" distance="2.0" fontFamily="Dialog" fontSize="12" fontStyle="plain" hasBackgroundColor="false" hasLineColor="false" horizontalTextPosition="center" iconTextGap="4" modelName="six_pos" modelPosition="thead" preferredPlacement="target_on_edge" ratio="0.5" textColor="#000000" verticalTextPosition="bottom" visible="true" xml:space="preserve">1..*<y:PreferredPlacementDescriptor angle="0.0" angleOffsetOnRightSide="0" angleReference="absolute" angleRotationOnRightSide="co" distance="-1.0" placement="target" side="anywhere" sideReference="relative_to_edge_flow"/>
      </y:EdgeLabel>
            </y:PolyLineEdge>
         </data>
      </edge>
      <data xmlns:y="http://www.yworks.com/xml/graphml" key="k4">
         <y:Postprocessors>
            <y:Processor class="yext.graphml.processor.NodeSizeAdapter">
               <y:Option name="IGNORE_WIDTHS" value="false"/>
               <y:Option name="IGNORE_HEIGHTS" value="false"/>
               <y:Option name="ADAPT_TO_MAXIMUM_NODE" value="false"/>
            </y:Processor>
            <y:Processor class="y.module.TreeLayoutModule">
               <y:Option name="GENERAL.LAYOUT_STYLE" value="AR"/>
               <y:Option name="AR.BEND_DISTANCE" value="20"/>
               <y:Option name="AR.VERTICAL_SPACE" value="10"/>
               <y:Option name="AR.ASPECT_RATIO" value="1.41"/>
               <y:Option name="AR.HORIZONTAL_SPACE" value="10"/>
               <y:Option name="AR.USE_VIEW_ASPECT_RATIO" value="true"/>
            </y:Processor>
         </y:Postprocessors>
      </data>
   </graph>
</graphml>
