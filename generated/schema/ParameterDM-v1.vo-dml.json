        },
        "content" : {
          "type" : "array",
          "items" : {
            "anyOf" : [ ]
          },
          "additionalProperties" : false
        }
      },
      "additionalProperties" : false
    }
  },
  "$defs" : {
    "$comment" : "placeholder to make commas easier!",
    "BaseParameterType" : {
      "type" : "object",
