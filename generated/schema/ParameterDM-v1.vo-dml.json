{
  "$schema" : "https://json-schema.org/draft/2020-12/schema",
  "$id" : "https://ivoa.net/dm/ParameterDM-v1.vo-dml.json",
  "title" : "",
  "description" : "Parameter Data Model for tool inputs and outputs",
  "type" : "object",
  "properties" : {
    "PdlModel" : {
      "type" : "object",
      "properties" : {
        "refs" : {
          "type" : "object",
          "properties" : {
            "$comment" : "placeholder to make commas easier!"
          },
          "additionalProperties" : false
        },
        "content" : {
          "type" : "array",
          "items" : {
            "anyOf" : [ {
              "$ref" : "https://ivoa.net/dm/ParameterDM-v1.vo-dml.json#/$defs/ToolInterface"
            } ]
          },
          "additionalProperties" : false
        }
      },
      "additionalProperties" : false
    }
  },
  "$defs" : {
    "$comment" : "placeholder to make commas easier!",
    "ParameterType" : {
      "type" : "object",
      "description" : "The kind of the parameter",
      "properties" : {
        "$comment" : "placeholder to make commas easier!"
      },
      "required" : [ ],
      "additionalProperties" : false
    },
    "FileParameterType" : {
      "type" : "object",
      "description" : "a parameter type that is a file",
      "properties" : {
        "$comment" : "placeholder to make commas easier!",
        "mime" : {
          "type" : "string",
          "description" : "mime type describing the file"
        }
      },
      "required" : [ ],
      "additionalProperties" : false
    },
    "AtomicParameterType" : {
      "type" : "object",
      "description" : "a parameterType that typically can be represented by primitive",
      "properties" : {
        "$comment" : "placeholder to make commas easier!",
        "kind" : {
          "type" : "string",
          "description" : "the type of the parameter"
        }
      },
      "required" : [ "kind" ],
      "additionalProperties" : false
    },
    "ParameterSemantics" : {
      "type" : "object",
      "description" : "a base type for semantics",
      "properties" : {
        "$comment" : "placeholder to make commas easier!",
        "@type" : {
          "type" : "string"
        }
      },
      "required" : [ "@type" ]
    },
    "IVOASemantics" : {
      "allOf" : [ {
        "$ref" : "https://ivoa.net/dm/ParameterDM-v1.vo-dml.json#/$defs/ParameterSemantics"
      }, {
        "type" : "object",
        "description" : "",
        "properties" : {
          "$comment" : "placeholder to make commas easier!",
          "ucd" : {
            "type" : "string",
            "description" : "a UCD"
          }
        },
        "required" : [ ]
      } ],
      "unevaluatedProperties" : false
    },
    "ParameterDefinition" : {
      "type" : "object",
      "description" : "the definition of a parameter",
      "properties" : {
        "$comment" : "placeholder to make commas easier",
        "@type" : {
          "type" : "string",
          "description" : "UType as type discriminator"
        },
        "name" : {
          "type" : "string",
          "description" : "Parameter name"
        },
        "description" : {
          "type" : "string",
          "description" : "Parameter description"
        },
        "kind" : {
          "$ref" : "https://ivoa.net/dm/ParameterDM-v1.vo-dml.json#/$defs/ParameterType",
          "description" : "the type of the parameter"
        },
        "semantics" : {
          "$ref" : "https://ivoa.net/dm/ParameterDM-v1.vo-dml.json#/$defs/ParameterSemantics",
          "description" : ""
        },
        "_id" : {
          "type" : "integer",
          "description" : "surrogate key"
        }
      },
      "required" : [ "name", "kind" ],
      "additionalProperties" : false
    },
    "ParameterGroup" : {
      "type" : "object",
      "description" : "a group of parameter Definitions",
      "properties" : {
        "$comment" : "placeholder to make commas easier",
        "@type" : {
          "type" : "string",
          "description" : "UType as type discriminator"
        },
        "name" : {
          "type" : "string",
          "description" : "Group name"
        },
        "members" : {
          "type" : "array",
          "items" : {
            "$ref" : "https://ivoa.net/dm/ParameterDM-v1.vo-dml.json#/$defs/ParameterOrGroup"
          }
        },
        "_id" : {
          "type" : "integer",
          "description" : "surrogate key"
        }
      },
      "required" : [ "name", "members" ],
      "additionalProperties" : false
    },
    "ParameterOrGroup" : {
      "type" : "object",
      "description" : "a 'choice' type",
      "properties" : {
        "$comment" : "placeholder to make commas easier",
        "@type" : {
          "type" : "string",
          "description" : "UType as type discriminator"
        },
        "param" : {
          "oneOf" : [ {
            "type" : "number"
          }, {
            "$ref" : "https://ivoa.net/dm/ParameterDM-v1.vo-dml.json#/$defs/ParameterDefinition"
          } ],
          "description" : ""
        },
        "group" : {
          "oneOf" : [ {
            "type" : "number"
          }, {
            "$ref" : "https://ivoa.net/dm/ParameterDM-v1.vo-dml.json#/$defs/ParameterGroup"
          } ],
          "description" : ""
        },
        "_id" : {
          "type" : "integer",
          "description" : "surrogate key"
        }
      },
      "required" : [ ],
      "additionalProperties" : false
    },
    "ToolInterface" : {
      "type" : "object",
      "description" : "The definition of the tool interface",
      "properties" : {
        "$comment" : "placeholder to make commas easier",
        "@type" : {
          "type" : "string",
          "description" : "UType as type discriminator"
        },
        "parameters" : {
          "type" : "array",
          "items" : {
            "$ref" : "https://ivoa.net/dm/ParameterDM-v1.vo-dml.json#/$defs/ParameterDefinition"
          }
        },
        "groups" : {
          "type" : "array",
          "items" : {
            "$ref" : "https://ivoa.net/dm/ParameterDM-v1.vo-dml.json#/$defs/ParameterGroup"
          }
        },
        "input" : {
          "oneOf" : [ {
            "type" : "number"
          }, {
            "$ref" : "https://ivoa.net/dm/ParameterDM-v1.vo-dml.json#/$defs/ParameterGroup"
          } ],
          "description" : "The group of of parameters that are required for tool execution - i.e. input"
        },
        "output" : {
          "oneOf" : [ {
            "type" : "number"
          }, {
            "$ref" : "https://ivoa.net/dm/ParameterDM-v1.vo-dml.json#/$defs/ParameterGroup"
          } ],
          "description" : "The group of parameters that are produced by tool execution - i.e. output"
        },
        "_id" : {
          "type" : "integer",
          "description" : "surrogate key"
        }
      },
      "required" : [ ],
      "additionalProperties" : false
    }
  }
}