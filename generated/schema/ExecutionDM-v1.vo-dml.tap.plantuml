

@startuml

' hide the spot
' hide circle

' avoid problems with angled crows feet
skinparam linetype ortho
        
entity "execution.PhysicalLocation" as execution.PhysicalLocation {

    ID : BIGINT

---

    name : VARCHAR
country : VARCHAR
longitude : DOUBLE
latitude : DOUBLE

}

entity "execution.ExecutionNode" as execution.ExecutionNode {

    ID : BIGINT

---

    resourcesServiceUrl : VARCHAR
executionServiceUrl : VARCHAR
location : BIGINT

---
      location : BIGINT<<FK>>

}

entity "execution.ComputeResource" as execution.ComputeResource {

    ID : BIGINT

---

    EXECUTIONNODE_ID : BIGINT
name : VARCHAR
numberOfCores : INTEGER
memory : DOUBLE
gpu : INTEGER
gpuType : VARCHAR

---
      EXECUTIONNODE_ID : BIGINT<<FK>>

}

entity "execution.TransferPerformance" as execution.TransferPerformance {

    ID : BIGINT

---

    fromLocation : BIGINT
throughput : DOUBLE
latency : DOUBLE
errorRate : DOUBLE
timestamp : TIMESTAMP

---
      fromLocation : BIGINT<<FK>>

}

entity "execution.DataNode" as execution.DataNode {

    ID : BIGINT

---

    storageServiceUrl : VARCHAR
location : BIGINT

---
      location : BIGINT<<FK>>

}

entity "execution.DataResource" as execution.DataResource {

    ID : BIGINT

---

    location : BIGINT
size : DOUBLE
mimeType : VARCHAR
accessUrl : VARCHAR

---
      location : BIGINT<<FK>>

}

entity "execution.WorkLoad" as execution.WorkLoad {

    ID : BIGINT

---

    
}

entity "execution.ParameterValue" as execution.ParameterValue {

    ID : BIGINT

---

    id : VARCHAR
id : VARCHAR
definition : BIGINT
value : VARCHAR
isIndirect : INTEGER

---
      definition : BIGINT<<FK>>
id : VARCHAR<<FK>>
id : VARCHAR<<FK>>

}

entity "execution.JobExecution" as execution.JobExecution {

    id : VARCHAR

---

    runId : VARCHAR
ownerID : VARCHAR
tool : VARCHAR
status : VARCHAR
executionNode : BIGINT
creationTime : TIMESTAMP
startTime : TIMESTAMP
endTime : TIMESTAMP
destructionTime : TIMESTAMP

---
      tool : VARCHAR<<FK>>
executionNode : BIGINT<<FK>>

}

entity "execution.PerformanceMetric" as execution.PerformanceMetric {

    ID : BIGINT

---

    id : VARCHAR

---
      id : VARCHAR<<FK>>

}

entity "tool.Author" as tool.Author {

    ID : BIGINT

---

    name : VARCHAR
email : VARCHAR
role : VARCHAR
github : VARCHAR
gitlab : VARCHAR
orcid : VARCHAR
affiliation : VARCHAR

}

entity "tool.OCIRegistry" as tool.OCIRegistry {

    ID : BIGINT

---

    host : VARCHAR
project : VARCHAR

}

entity "tool.Discovery" as tool.Discovery {

    ID : BIGINT

---

    imageTitle : VARCHAR
description : VARCHAR
source : VARCHAR
url : VARCHAR
documentation : VARCHAR
version : VARCHAR
revision : VARCHAR
created : TIMESTAMP
authors : BIGINT
licenses : VARCHAR
keywords : VARCHAR
domain : VARCHAR
kind : VARCHAR
tools : VARCHAR
isBase : INTEGER
deprecated : INTEGER

---
      authors : BIGINT<<FK>>

}

entity "tool.EnvVar" as tool.EnvVar {

    ID : BIGINT

---

    id : VARCHAR
name : VARCHAR
value : VARCHAR

---
      id : VARCHAR<<FK>>

}

entity "tool.Vulnerability" as tool.Vulnerability {

    ID : BIGINT

---

    SECURITYMETADATA_ID : BIGINT
cve : VARCHAR

---
      SECURITYMETADATA_ID : BIGINT<<FK>>

}

entity "tool.Compliance" as tool.Compliance {

    ID : BIGINT

---

    SECURITYMETADATA_ID : BIGINT

---
      SECURITYMETADATA_ID : BIGINT<<FK>>

}

entity "tool.SecurityMetadata" as tool.SecurityMetadata {

    ID : BIGINT

---

    signature : VARCHAR

}

entity "tool.ToolImage" as tool.ToolImage {

    ID : BIGINT

---

    registry : BIGINT
parentImage : BIGINT

---
      registry : BIGINT<<FK>>
parentImage : BIGINT<<FK>>

}

entity "tool.BuildProcess" as tool.BuildProcess {

    ID : BIGINT

---

    buildCommand : VARCHAR
buildContext : VARCHAR
dockerfilePath : VARCHAR

}

entity "tool.Tool" as tool.Tool {

    id : VARCHAR

---

    image : BIGINT
command : VARCHAR

---
      image : BIGINT<<FK>>

}

entity "tool.PerformanceProfile" as tool.PerformanceProfile {

    ID : BIGINT

---

    
}

entity "tool.ProcessorScaling" as tool.ProcessorScaling {

    ID : BIGINT

---

    
}

entity "tool.DataScaling" as tool.DataScaling {

    ID : BIGINT

---

    
}

entity "pdl.ParameterDefinition" as pdl.ParameterDefinition {

    ID : BIGINT

---

    TOOLINTERFACE_ID : BIGINT
name : VARCHAR
description : VARCHAR
kind : UNKNOWN
semantics_ucd : VARCHAR

---
      TOOLINTERFACE_ID : BIGINT<<FK>>

}

entity "pdl.ParameterGroup" as pdl.ParameterGroup {

    ID : BIGINT

---

    TOOLINTERFACE_ID : BIGINT
name : VARCHAR

---
      TOOLINTERFACE_ID : BIGINT<<FK>>

}

entity "pdl.ParameterOrGroup" as pdl.ParameterOrGroup {

    ID : BIGINT

---

    PARAMETERGROUP_ID : BIGINT
param : BIGINT
group : BIGINT

---
      param : BIGINT<<FK>>
group : BIGINT<<FK>>
PARAMETERGROUP_ID : BIGINT<<FK>>

}

entity "pdl.ToolInterface" as pdl.ToolInterface {

    ID : BIGINT

---

    input : BIGINT
output : BIGINT

---
      input : BIGINT<<FK>>
output : BIGINT<<FK>>

}


        execution.ExecutionNode }o--||execution.PhysicalLocation
execution.ComputeResource }o--||execution.ExecutionNode
execution.TransferPerformance }o--||execution.PhysicalLocation
execution.DataNode }o--||execution.PhysicalLocation
execution.DataResource }o--||execution.PhysicalLocation
execution.ParameterValue }o--||pdl.ParameterDefinition
execution.ParameterValue }o--||execution.JobExecution
execution.ParameterValue }o--||execution.JobExecution
execution.JobExecution }o--||tool.Tool
execution.JobExecution }o--||execution.ExecutionNode
execution.PerformanceMetric }o--||execution.JobExecution
tool.Discovery }o--||tool.Author
tool.EnvVar }o--||tool.Tool
tool.Vulnerability }o--||tool.SecurityMetadata
tool.Compliance }o--||tool.SecurityMetadata
tool.ToolImage }o--||tool.OCIRegistry
tool.ToolImage }o--||tool.ToolImage
tool.Tool }o--||tool.ToolImage
pdl.ParameterDefinition }o--||pdl.ToolInterface
pdl.ParameterGroup }o--||pdl.ToolInterface
pdl.ParameterOrGroup }o--||pdl.ParameterDefinition
pdl.ParameterOrGroup }o--||pdl.ParameterGroup
pdl.ParameterOrGroup }o--||pdl.ParameterGroup
pdl.ToolInterface }o--||pdl.ParameterGroup
pdl.ToolInterface }o--||pdl.ParameterGroup



@enduml

    