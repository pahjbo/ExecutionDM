{
  "$schema" : "https://json-schema.org/draft/2020-12/schema",
  "$id" : "https://ivoa.net/dm/ToolDM-v1.vo-dml.json",
  "title" : "",
  "description" : "Tool Data Model for defining executable tools",
  "type" : "object",
  "properties" : {
    "ToolModel" : {
      "type" : "object",
      "properties" : {
        "refs" : {
          "type" : "object",
          "properties" : {
            "$comment" : "placeholder to make commas easier!",
            "tool:tool.OCIRegistry" : {
              "type" : "array",
              "items" : {
                "oneOf" : [ {
                  "$ref" : "https://ivoa.net/dm/ToolDM-v1.vo-dml.json#/$defs/tool.OCIRegistry"
                }, {
                  "type" : "number"
                } ]
              }
            },
            "tool:tool.ToolImage" : {
              "type" : "array",
              "items" : {
                "oneOf" : [ {
                  "$ref" : "https://ivoa.net/dm/ToolDM-v1.vo-dml.json#/$defs/tool.ToolImage"
                }, {
                  "type" : "number"
                } ]
              }
            }
          },
          "additionalProperties" : false
        },
        "content" : {
          "type" : "array",
          "items" : {
            "anyOf" : [ {
              "$ref" : "https://ivoa.net/dm/ToolDM-v1.vo-dml.json#/$defs/tool.ToolInterface"
            }, {
              "$ref" : "https://ivoa.net/dm/ToolDM-v1.vo-dml.json#/$defs/tool.Tool"
            } ]
          },
          "additionalProperties" : false
        }
      },
      "additionalProperties" : false
    }
  },
  "$defs" : {
    "$comment" : "placeholder to make commas easier!",
    "tool.Author" : {
      "type" : "object",
      "description" : "Details about an author of the image",
      "properties" : {
        "$comment" : "placeholder to make commas easier",
        "@type" : {
          "type" : "string",
          "description" : "UType as type discriminator"
        },
        "name" : {
          "type" : "string",
          "description" : "Name of the author"
        },
        "email" : {
          "type" : "string",
          "description" : "Contact email address for the author"
        },
        "role" : {
          "type" : "string",
          "description" : "Role of the author; default maintainer"
        },
        "github" : {
          "type" : "string",
          "description" : "GitHub username"
        },
        "gitlab" : {
          "type" : "string",
          "description" : "GitLab username"
        },
        "orcid" : {
          "type" : "string",
          "description" : "ORCID identifier"
        },
        "affiliation" : {
          "type" : "string",
          "description" : "Affiliation"
        },
        "_id" : {
          "type" : "integer",
          "description" : "surrogate key"
        }
      },
      "required" : [ "name", "email" ],
      "additionalProperties" : false
    },
    "tool.OCIRegistry" : {
      "type" : "object",
      "description" : "Details about the OCIcontainer registry",
      "properties" : {
        "$comment" : "placeholder to make commas easier",
        "@type" : {
          "type" : "string",
          "description" : "UType as type discriminator"
        },
        "host" : {
          "type" : "string",
          "description" : "Container registry hostname"
        },
        "project" : {
          "type" : "string",
          "description" : "Container registry project/namespace"
        },
        "_id" : {
          "type" : "integer",
          "description" : "surrogate key"
        }
      },
      "required" : [ "host", "project" ],
      "additionalProperties" : false
    },
    "tool.Discovery" : {
      "type" : "object",
      "description" : "Discovery metadata mapped to OCI labels/annotations",
      "properties" : {
        "$comment" : "placeholder to make commas easier",
        "@type" : {
          "type" : "string",
          "description" : "UType as type discriminator"
        },
        "imageTitle" : {
          "type" : "string",
          "description" : "Human-readable title (schema field: title)"
        },
        "description" : {
          "type" : "string",
          "description" : "Human-readable description (1..255 chars)"
        },
        "source" : {
          "type" : "string",
          "format" : "uri",
          "description" : "Source code URL"
        },
        "url" : {
          "type" : "string",
          "format" : "uri",
          "description" : "Project URL"
        },
        "documentation" : {
          "type" : "string",
          "format" : "uri",
          "description" : "Documentation URL"
        },
        "version" : {
          "type" : "string",
          "description" : "Packaged software version"
        },
        "revision" : {
          "type" : "string",
          "description" : "Source control revision; default unknown"
        },
        "created" : {
          "type" : "string",
          "format" : "date-time",
          "description" : "Metadata processing timestamp (UTC)"
        },
        "authors" : {
          "type" : "array",
          "items" : {
            "$ref" : "https://ivoa.net/dm/ToolDM-v1.vo-dml.json#/$defs/tool.Author"
          }
        },
        "licenses" : {
          "type" : "string",
          "description" : "SPDX license expression"
        },
        "keywords" : {
          "type" : "array",
          "items" : {
            "type" : "string"
          },
          "description" : "Discovery/search keywords"
        },
        "domain" : {
          "type" : "array",
          "items" : {
            "type" : "string"
          },
          "description" : "Scientific domains; default astronomy; min_length=1"
        },
        "kind" : {
          "type" : "array",
          "items" : {
            "type" : "string"
          },
          "description" : "One of notebook|headless|carta|firefly|contributed|desktop; min_length=1"
        },
        "tools" : {
          "type" : "array",
          "items" : {
            "type" : "string"
          },
          "description" : "Scientific software packages included"
        },
        "deprecated" : {
          "type" : "boolean",
          "description" : "Deprecation status; default false"
        },
        "_id" : {
          "type" : "integer",
          "description" : "surrogate key"
        }
      },
      "required" : [ "imageTitle", "description", "source", "version", "licenses", "domain", "kind" ],
      "additionalProperties" : false
    },
    "tool.EnvVar" : {
      "type" : "object",
      "description" : "Environment variable map entry",
      "properties" : {
        "$comment" : "placeholder to make commas easier",
        "@type" : {
          "type" : "string",
          "description" : "UType as type discriminator"
        },
        "name" : {
          "type" : "string",
          "description" : "Environment variable name"
        },
        "value" : {
          "type" : "string",
          "description" : "Environment variable value"
        },
        "_id" : {
          "type" : "integer",
          "description" : "surrogate key"
        }
      },
      "required" : [ "name", "value" ],
      "additionalProperties" : false
    },
    "tool.ToolImage" : {
      "type" : "object",
      "description" : "Definition of a tool image",
      "properties" : {
        "$comment" : "placeholder to make commas easier",
        "@type" : {
          "type" : "string",
          "description" : "UType as type discriminator"
        },
        "registry" : {
          "oneOf" : [ {
            "type" : "number"
          }, {
            "$ref" : "https://ivoa.net/dm/ToolDM-v1.vo-dml.json#/$defs/tool.OCIRegistry"
          } ],
          "description" : "OCI registry details"
        },
        "build" : {
          "type" : "object",
          "$ref" : "https://ivoa.net/dm/ToolDM-v1.vo-dml.json#/$defs/tool.BuildProcess"
        },
        "discovery" : {
          "type" : "object",
          "$ref" : "https://ivoa.net/dm/ToolDM-v1.vo-dml.json#/$defs/tool.Discovery"
        },
        "_id" : {
          "type" : "integer",
          "description" : "surrogate key"
        }
      },
      "required" : [ "registry", "build", "discovery" ],
      "additionalProperties" : false
    },
    "tool.BuildProcess" : {
      "type" : "object",
      "description" : "",
      "properties" : {
        "$comment" : "placeholder to make commas easier",
        "@type" : {
          "type" : "string",
          "description" : "UType as type discriminator"
        },
        "_id" : {
          "type" : "integer",
          "description" : "surrogate key"
        }
      },
      "required" : [ ],
      "additionalProperties" : false
    },
    "tool.ToolInterface" : {
      "type" : "object",
      "description" : "",
      "properties" : {
        "$comment" : "placeholder to make commas easier",
        "@type" : {
          "type" : "string",
          "description" : "UType as type discriminator"
        },
        "pg" : {
          "type" : "array",
          "items" : {
            "$ref" : "https://ivoa.net/dm/ParameterDM-v1.vo-dml.json#/$defs/ParameterGroup"
          }
        },
        "_id" : {
          "type" : "integer",
          "description" : "surrogate key"
        }
      },
      "required" : [ ],
      "additionalProperties" : false
    },
    "tool.Tool" : {
      "type" : "object",
      "description" : "Definition of a Library Tool",
      "properties" : {
        "$comment" : "placeholder to make commas easier",
        "@type" : {
          "type" : "string",
          "description" : "UType as type discriminator"
        },
        "id" : {
          "type" : "string",
          "description" : "Unique tool identifier"
        },
        "image" : {
          "oneOf" : [ {
            "type" : "number"
          }, {
            "$ref" : "https://ivoa.net/dm/ToolDM-v1.vo-dml.json#/$defs/tool.ToolImage"
          } ],
          "description" : "Tool container image reference"
        },
        "command" : {
          "type" : "array",
          "items" : {
            "type" : "string"
          },
          "description" : "Tokenized initial command; supports {{inputs.key}} min_length=1"
        },
        "env" : {
          "type" : "array",
          "items" : {
            "$ref" : "https://ivoa.net/dm/ToolDM-v1.vo-dml.json#/$defs/tool.EnvVar"
          }
        },
        "inputs" : {
          "type" : "array",
          "items" : {
            "anyOf" : [ {
              "$ref" : "https://ivoa.net/dm/ParameterDM-v1.vo-dml.json#/$defs/ParameterDefinition"
            }, {
              "$ref" : "https://ivoa.net/dm/ParameterDM-v1.vo-dml.json#/$defs/ParameterGroup"
            } ]
          }
        },
        "outputs" : {
          "type" : "array",
          "items" : {
            "anyOf" : [ {
              "$ref" : "https://ivoa.net/dm/ParameterDM-v1.vo-dml.json#/$defs/ParameterDefinition"
            }, {
              "$ref" : "https://ivoa.net/dm/ParameterDM-v1.vo-dml.json#/$defs/ParameterGroup"
            } ]
          }
        }
      },
      "required" : [ "id", "image", "command", "outputs" ],
      "additionalProperties" : false
    }
  }
}