
digraph GVmap {  
	label = "\n\npdl data model"
	rankdir=TB
	
	node [ 
	  shape=tab
	  style=filled
	]
	subgraph cluster_packages {
	  label="Model"
	  rankdir=TB
      style=filled
      fillcolor="/set312/1"
	  
	}
	
	node [
	shape=record
	fontsize=8
	style=filled] 
    "pdl:ValueEncoding" [
    URL="../pdl/ValueEncoding"
    label = "{&lt;&lt;enumeration&gt;&gt;\nValueEncoding|+PLAIN\l+URI\l+BASE64\l}"
    fillcolor="/set312/1"
    ] ;
  "pdl:ParameterLiteral" [
    URL="../pdl/ParameterLiteral"
    label = "{&lt;&lt;datatype&gt;&gt;\nParameterLiteral}"
    fillcolor="/set312/1"
    ] ;
  "pdl:StringLiteral" [
    URL="../pdl/StringLiteral"
    label = "{&lt;&lt;datatype&gt;&gt;\nStringLiteral|+value : ivoa:string\l}"
    fillcolor="/set312/1"
    ] ;
  "pdl:IntegerLiteral" [
    URL="../pdl/IntegerLiteral"
    label = "{&lt;&lt;datatype&gt;&gt;\nIntegerLiteral|+value : ivoa:integer\l}"
    fillcolor="/set312/1"
    ] ;
  "pdl:RealLiteral" [
    URL="../pdl/RealLiteral"
    label = "{&lt;&lt;datatype&gt;&gt;\nRealLiteral|+value : ivoa:real\l}"
    fillcolor="/set312/1"
    ] ;
  "pdl:BooleanLiteral" [
    URL="../pdl/BooleanLiteral"
    label = "{&lt;&lt;datatype&gt;&gt;\nBooleanLiteral|+value : ivoa:boolean\l}"
    fillcolor="/set312/1"
    ] ;
  "pdl:UriLiteral" [
    URL="../pdl/UriLiteral"
    label = "{&lt;&lt;datatype&gt;&gt;\nUriLiteral|+value : ivoa:anyURI\l}"
    fillcolor="/set312/1"
    ] ;
  "pdl:JsonLiteral" [
    URL="../pdl/JsonLiteral"
    label = "{&lt;&lt;datatype&gt;&gt;\nJsonLiteral|+value : ivoa:string\l}"
    fillcolor="/set312/1"
    ] ;
  "pdl:ParameterType" [
    URL="../pdl/ParameterType"
    label = "{&lt;&lt;datatype&gt;&gt;\nParameterType}"
    fillcolor="/set312/1"
    ] ;
  "pdl:FileParameterType" [
    URL="../pdl/FileParameterType"
    label = "{&lt;&lt;datatype&gt;&gt;\nFileParameterType|+mime : ivoa:string\l}"
    fillcolor="/set312/1"
    ] ;
  "pdl:AtomicParameterType" [
    URL="../pdl/AtomicParameterType"
    label = "{&lt;&lt;datatype&gt;&gt;\nAtomicParameterType|+kind : ivoa:string\l}"
    fillcolor="/set312/1"
    ] ;
  "pdl:ParameterSemantics" [
    URL="../pdl/ParameterSemantics"
    label = "{&lt;&lt;datatype&gt;&gt;\nParameterSemantics}"
    fillcolor="/set312/1"
    ] ;
  "pdl:IVOASemantics" [
    URL="../pdl/IVOASemantics"
    label = "{&lt;&lt;datatype&gt;&gt;\nIVOASemantics|+ucd : ivoa:string\l+utype : ivoa:string\l}"
    fillcolor="/set312/1"
    ] ;
  "pdl:ParameterDefinition" [
    URL="../pdl/ParameterDefinition"
    label = "{ParameterDefinition|+name : ivoa:string\l+description : ivoa:string\l+kind : pdl:ParameterType\l+defaultValue : pdl:ParameterLiteral\l+encoding : pdl:ValueEncoding\l+semantics : pdl:ParameterSemantics\l}"
    fillcolor="/set312/1"
    ] ;
  "pdl:ParameterGroup" [
    URL="../pdl/ParameterGroup"
    label = "{ParameterGroup|+name : ivoa:string\l}"
    fillcolor="/set312/1"
    ] ;
  "pdl:ParameterOrGroup" [
    URL="../pdl/ParameterOrGroup"
    label = "{ParameterOrGroup|+required : ivoa:boolean\l+minItems : ivoa:integer\l+maxItems : ivoa:integer\l}"
    fillcolor="/set312/1"
    ] ;
  "pdl:ToolInterface" [
    URL="../pdl/ToolInterface"
    label = "{ToolInterface}"
    fillcolor="/set312/1"
    ] ;
  
 
    edge [color="red", arrowtail="none", arrowhead="empty"]
    "pdl:StringLiteral" -> "pdl:ParameterLiteral" ;
  "pdl:IntegerLiteral" -> "pdl:ParameterLiteral" ;
  "pdl:RealLiteral" -> "pdl:ParameterLiteral" ;
  "pdl:BooleanLiteral" -> "pdl:ParameterLiteral" ;
  "pdl:UriLiteral" -> "pdl:ParameterLiteral" ;
  "pdl:JsonLiteral" -> "pdl:ParameterLiteral" ;
  "pdl:FileParameterType" -> "pdl:ParameterType" ;
  "pdl:AtomicParameterType" -> "pdl:ParameterType" ;
  "pdl:IVOASemantics" -> "pdl:ParameterSemantics" ;
  
 
    edge [color="blue", arrowhead="open", arrowtail="diamond",dir="both",fontsize="10"]
    "pdl:ParameterGroup" -> "pdl:ParameterOrGroup" [headlabel="1..*",label="members",labelfontsize=10] ;
  "pdl:ToolInterface" -> "pdl:ParameterDefinition" [headlabel="0..*",label="parameters",labelfontsize=10] ;
  "pdl:ToolInterface" -> "pdl:ParameterGroup" [headlabel="0..*",label="groups",labelfontsize=10] ;
  
 
    edge [color="green", arrowhead="open", arrowtail="none"]
    "pdl:ParameterOrGroup" -> "pdl:ParameterDefinition" [headlabel="0..1",label="param",labelfontsize=10] ;
  "pdl:ParameterOrGroup" -> "pdl:ParameterGroup" [headlabel="0..1",label="group",labelfontsize=10] ;
  "pdl:ToolInterface" -> "pdl:ParameterGroup" [headlabel="0..1",label="input",labelfontsize=10] ;
  "pdl:ToolInterface" -> "pdl:ParameterGroup" [headlabel="0..1",label="output",labelfontsize=10] ;
    
}
  